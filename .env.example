# 백엔드 API base URL (예: https://dolphin-device-evident.ngrok-free.dev). 카카오 로그인도 이 서버를 거친다
NEXT_PUBLIC_API_BASE_URL=

# MSW 브라우저 mock 사용 여부 (enabled | disabled)
NEXT_PUBLIC_API_MOCKING=disabled

# 네이버 지도 JavaScript API 키 (NCP Maps). 브라우저에 노출되는 값이라 서비스 URL 제한을 건다
NEXT_PUBLIC_NAVER_MAPS_CLIENT_ID=

# 네이버 검색 API(지역) — 일정 개설 장소 검색. 서버(Route Handler /api/places)에서만 쓴다. NEXT_PUBLIC을 붙이지 않는다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
