# 백엔드 API base URL
NEXT_PUBLIC_API_BASE_URL=

# MSW 브라우저 mock 사용 여부 (enabled | disabled)
NEXT_PUBLIC_API_MOCKING=disabled

# 카카오 로그인 — REST API 키 (Kakao Developers > 앱 키). Client Secret은 백엔드에만 둔다
NEXT_PUBLIC_KAKAO_REST_API_KEY=

# 카카오 로그인 — Kakao Developers에 등록한 로그인 Redirect URI와 정확히 같은 값
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
